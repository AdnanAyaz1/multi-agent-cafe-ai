# ==============================================================================
# AI PROVIDERS & MODELS (Multi-Agent Setup)
# ==============================================================================

# Primary Provider: Google Gemini (Recommended - 1,500 free requests/day)
# Accepts GOOGLE_GENERATIVE_AI_API_KEY, GOOGLE_AI_API_KEY, or GEMINI_API_KEY
# Get free API key at: https://aistudio.google.com/
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key-here

# Secondary / Fallback Provider: Groq
# Get free API key at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Preferred Provider Strategy: 'hybrid' (recommended), 'google', or 'groq'
# When both keys are present, 'hybrid' is selected automatically:
# - Groq (openai/gpt-oss-20b) handles high-speed extraction (menu, weather, scraping) & (openai/gpt-oss-120b) for critic
# - Google Gemini (gemini-3.8-flash) handles deep strategy reasoning & executive briefing synthesis
AI_PROVIDER=hybrid

# Max critic <-> strategist revision rounds in LangGraph loop
MAX_REVISIONS=2

# Optional: LangSmith Agent Tracing & Observability
# Sign up at: https://smith.langchain.com/
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-key
# LANGCHAIN_PROJECT=cafepromo-ai

# Optional: Per-Agent Model Overrides (defaults automatically assign based on role complexity)
# Extraction / High-Speed agents (default: gemini-3.5-flash-lite or openai/gpt-oss-20b):
# MODEL_MENU_ANALYST=gemini-3.5-flash-lite
# MODEL_WEATHER_ANALYST=gemini-3.5-flash-lite
# MODEL_COMPETITOR_PARSER=gemini-3.5-flash-lite
# Deep Reasoning agents (default: gemini-3.8-flash or openai/gpt-oss-120b):
# MODEL_STRATEGIST=gemini-3.8-flash
# MODEL_CRITIC=gemini-3.8-flash
# Executive Briefing agents (default: gemini-3.8-flash):
# MODEL_SYNTHESIZER=gemini-3.8-flash
# MODEL_COMPETITOR_ANALYST=gemini-3.8-flash

# Concurrency for parallel pipelines
ANALYSIS_CONCURRENCY=2
COMPETITOR_CONCURRENCY=2

# --- Database ----------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bi_platform

# --- Redis (for BullMQ workers) ----------------------------------
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Scraping (for competitor analysis) --------------------------
# ScrapingBee: used on Vercel (Playwright runs locally without this)
# Free tier: https://www.scrapingbee.com/ — 1k credits/mo
SCRAPINGBEE_API_KEY=

# --- App ---------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Auth --------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-random-secret

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Stripe -------------------------------------------------------
# Get keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
STRIPE_GROWTH_PRICE_ID=price_replace-me
STRIPE_ENTERPRISE_PRICE_ID=price_replace-me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace-me

# --- Inngest (for Vercel background jobs) ------------------------
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# --- Cron schedules -----------------------------------------------
WEATHER_FETCH_CRON=0 6 * * *
COMPETITOR_SCRAPE_CRON=0 8 * * *
DAILY_ANALYSIS_CRON=0 9 * * *

# --- Test scripts -------------------------------------------------
TEST_BUSINESS_ID=test-biz-1
TEST_CITY=Tokyo
